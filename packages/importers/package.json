{
  "name": "gapmcp-importers",
  "version": "0.1.0",
  "description": "Turn OpenAPI specs and Next.js route trees into curated Gap actions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git@github.com:Abhinav-Prabhakar/Gap.git"
  },
  "homepage": "https://github.com/Abhinav-Prabhakar/Gap#readme",
  "bugs": {
    "url": "https://github.com/Abhinav-Prabhakar/Gap/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "gapmcp-core": "workspace:^",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
