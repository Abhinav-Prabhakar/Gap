{
  "name": "gapmcp",
  "version": "0.1.0",
  "description": "Gap: typed actions for agents. One contract for MCP, OpenAPI and UI automation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git@github.com:Abhinav-Prabhakar/Gap.git"
  },
  "homepage": "https://github.com/Abhinav-Prabhakar/Gap#readme",
  "bugs": {
    "url": "https://github.com/Abhinav-Prabhakar/Gap/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/auth.ts src/policy.ts src/observability.ts src/dom.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "gapmcp-core": "workspace:^",
    "gapmcp-server": "workspace:^",
    "gapmcp-auth": "workspace:^",
    "gapmcp-policy": "workspace:^",
    "gapmcp-observability": "workspace:^",
    "gapmcp-dom": "workspace:^"
  }
}
