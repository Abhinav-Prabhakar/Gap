{
  "name": "gap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "demo": "tsx examples/demo/src/server.ts",
    "test:python": "cd python && uv run --offline pytest -q",
    "test:go": "cd go && go test -race -count=1 ./...",
    "build:binaries": "./scripts/build-binaries.sh"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.6.2",
    "tsup": "^9.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
